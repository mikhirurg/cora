e0 :: list -> list
e1 :: list -> Bool -> list
e2 :: Int -> Int -> list
e3 :: Int -> Bool -> list
e0(l) -> e1(l, SET(0, 1))
e1(l, true) -> e2(listLen(l), listToArray(l))
e2(size, addr) -> e3(addr, heapSort(addr))
e3(addr, true) -> arrayToList(addr)

ex0 :: list -> list
ex1 :: list -> Bool -> list
ex2 :: Int -> Int -> list
ex3 :: Int -> Bool -> list
ex0(l) -> ex1(l, SET(0, 1))
ex1(l, true) -> ex2(listLen(l), listToArray(l))
ex2(size, addr) -> ex3(addr, qSort(addr, 0, size))
ex3(addr, true) -> arrayToList(addr)