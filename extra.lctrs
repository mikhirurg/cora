/* binary search tree */
leaf :: bTree
node :: Int -> bTree -> bTree -> bTree

tree1 :: bTree
tree1 -> node (1, node(2, leaf, leaf), leaf)

insert :: Int -> bTree -> bTree
insert(e, leaf) -> node(e, leaf, leaf)
insert(e, node(n, l, r)) -> node(n, insert(e, l), r) | e <= n
insert(e, node(n, l, r)) -> node(n, l, insert(e, r)) | e > n

getMin :: bTree -> Int
getMin(node(n, leaf, leaf)) -> n
getMin(node(n, l, r)) -> getMin(l)

getMax :: bTree -> Int
getMax(node(n, leaf, leaf)) -> n
getMax(node(n, l, r)) -> getMin(l)