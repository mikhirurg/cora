READ :: Int
WRITE :: Int -> Int

/* list data structure */
nil :: list
cons :: Int -> list -> list

intITE :: Bool -> Int -> Int -> Int
intITE(true, a, b) -> a
intITE(false, a, b) -> b

boolITE :: Bool -> Bool -> Bool -> Bool
boolITE(true, a, b) -> a
boolITE(false, a, b) -> b

/* list -> size -> index -> intList */
getBList :: Int -> Int -> Bool
getBList(list, i) -> boolITE(list % 2 = 0, false, true) | i = 0
getBList(list, i) -> getBList(list / 2, i - 1) | i > 0

/* list -> size -> index -> value -> tail -> pow2 -> intList */
setBList1 :: Int -> Int -> Int -> Bool -> Int -> Int -> Int
setBList1(list, size, i, val, tail, pow2) -> tail | size <= 0
setBList1(list, size, i, val, tail, pow2) ->
    setBList1(list / 2, size - 1, i - 1, val,
                tail + intITE(val, 1, 0) * pow2, pow2 * 2) | i = 0
setBList1(list, size, i, val, tail, pow2) ->
    setBList1(list / 2, size - 1, i - 1, val, tail + (list % 2) * pow2, pow2 * 2) | i != 0

/* list -> size -> index -> value -> intList */
setBList :: Int -> Int -> Int -> Bool -> Int
setBList(list, size, i, val) -> setBList1(list, size, i, val, 0, 1)

/* bList -> size -> list */
bListToList1 :: Int -> Int -> list
bListToList1(bList, i) -> nil | i = 0
bListToList1(bList, i) -> cons(bList % 2, bListToList1(bList / 2, i - 1)) | i > 0

/* bList -> size -> list */
bListToList :: Int -> Int -> list
bListToList(bList, size) -> bListToList1(bList, size)

/* numlist1 */
numList1 :: Int
numList1 -> setBList(0, 3, 1, true)

/* graph data structure */
nilG :: graph
consG :: list -> graph -> graph

/* number of nodes in graph */
numNodes :: graph -> Int
numNodes(nilG) -> 0
numNodes(consG(l, g)) -> 1 + numNodes(g)

/* genList */
genList :: Int -> list
genList(n) -> nil | n = 0
genList(n) -> cons(0, genList(n-1)) | n > 0

/* Fill */
fill :: list -> Int -> list
fill(nil, a) -> nil
fill(cons(a, l), v) -> cons(v, fill(l, v))

/* Get from list */
getl :: Int -> list -> Int
getl(n, cons(m, l)) -> m | n = 0
getl(n, cons(m, l)) -> getl(n-1, l) | n > 0

/* Set value in the list */
setl :: Int -> Int -> list -> list
setl(n, v, cons(m, l)) -> cons(v, l) | n = 0
setl(n, v, cons(m, l)) -> cons(m, setl(n-1, v, l)) | n > 0

/* Get from graph */
getg :: Int -> graph -> list
getg(n, consG(l, g)) -> l | n = 0
getg(n, consG(l, g)) -> getg(n-1, g) | n > 0

c :: Int -> Int -> Int -> Int -> Int -> Int

/* bfs */
/* graph, currentNode */
bfs :: graph -> Int -> list

/* graph, stack, visitedNodes */
bfs1 :: graph -> list -> Int -> list

/* graph, currentNode, stack, visitedNodes */
bfs2 :: graph -> Int -> list -> Int -> list

/* graph, currentNode, stack, visitedNodes, node neighbours */
bfs3 :: graph -> Int -> list -> Int -> list -> list

/* graph, currentNode, stack, visitedNodes, node neighbours, is neighbour visited */
bfs4 :: graph -> Int -> list -> Int -> list -> Bool -> list

/*
bfs(graph, v) -> bfsLoop1(graph, cons(v, nil), genList(numNodes(graph)))
bfsLoop1(graph, nil, visited) -> visited
bfsLoop1(graph, cons(x, stk), visited) -> bfsLoop2(graph, x, stk, visited)
bfsLoop2(graph, x, q, visited) -> bfsLoop3(graph, x, q, setl(x, 1, visited), getg(x, graph))
bfsLoop3(graph, x, q, visited, nil) -> bfsLoop1(graph, q, visited)
bfsLoop3(graph, x, q, visited, cons(u, l)) ->
    bfsLoop4(graph, x, q, visited, cons(u, l), getl(u, visited))
bfsLoop4(graph, x, q, visited, cons(u, l), isVisited) ->
    bfsLoop3(graph, x, cons(u, q), visited, l) | isVisited = 0
bfsLoop4(graph, x, q, visited, cons(u, l), isVisited) ->
    bfsLoop3(graph, x, q, visited, l) | isVisited = 1
*/

/* bfs algorithm */
bfs(graph, start) -> bfs1(graph, cons(start, nil), 0)

/* Stack with nodes is empty - return the list of visited nodes */
bfs1(graph, nil, visited) -> bListToList(visited, numNodes(graph))

/* Stack with nodes is not empty - proceed with the algorithm */
bfs1(graph, cons(x, stk), visited) -> bfs2(graph, x, stk, visited)

/* Starting processing neighbours of the node x */
bfs2(graph, x, stk, visited) ->
    bfs3(graph, x, stk, setBList(visited, numNodes(graph), x, true), getg(x, graph))

/* Neighbours list is empty - return to pick node from the stack */
bfs3(graph, x, stk, visited, nil) -> bfs1(graph, stk, visited)

/* Neighbours list is not empty - process the next one */
bfs3(graph, x, stk, visited, cons(u, l)) ->
    bfs4(graph, x, stk, visited, cons(u, l), getBList(visited, u))

/* Neighbour node is not visited - add node to the stack */
bfs4(graph, x, stk, visited, cons(u, l), false) ->
    bfs3(graph, x, cons(u, stk), visited, l)

/* Neighbour node is visited - move to the next one */
bfs4(graph, x, stk, visited, cons(u, l), true) -> bfs3(graph, x, stk, visited, l)


/* Example list: [1, 2, 3, 4] */
list1 :: list
list1 -> cons(1, cons(2, cons(3, cons(4, nil))))

/* Example graph:
   (1) --> (2)
    |       ^
    |       |
    |    > (5)
    |   /
    |  /
    v /
   (3) --> (4) */
graph1 :: graph
graph1 -> consG(                    /* 1 */
            cons(1, cons(2, nil)),
          consG(nil,                /* 2 */
          consG(                    /* 3 */
            cons(3, cons(4, nil)),
          consG(nil,                /* 4 */
          consG(                    /* 5 */
            cons(1, nil),
          nilG)))))
graph2 :: graph
graph2 -> consG(cons(1, nil),
          consG(cons(2, nil),
          consG(cons(3, nil),
          consG(cons(0, nil),
          consG(cons(2, nil),
          consG(cons(4, nil),
          consG(cons(5, cons(7, nil)),
          consG(nil,
          consG(cons(9, nil),
          consG(cons(7, cons(10, nil)),
          consG(cons(8, nil),
          nilG)))))))))))