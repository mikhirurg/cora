READ :: Int
WRITE :: Int -> Bool

GET :: Int -> Int
SET :: Int -> Int -> Bool

/* list data structure */
nil :: list
cons :: Int -> list -> list

/* graph data structure */
nilG :: graph
consG :: list -> graph -> graph

/* number of nodes in graph */
numNodes :: graph -> Int
numNodes(nilG) -> 0
numNodes(consG(l, g)) -> 1 + numNodes(g)

/* genList */
genList :: Int -> list
genList(n) -> nil | n = 0
genList(n) -> cons(0, genList(n-1)) | n > 0

/* Fill */
fill :: list -> Int -> list
fill(nil, a) -> nil
fill(cons(a, l), v) -> cons(v, fill(l, v))

/* Get from list */
getl :: Int -> list -> Int
getl(n, cons(m, l)) -> m | n = 0
getl(n, cons(m, l)) -> getl(n-1, l) | n > 0

/* Set value in the list */
setl :: Int -> Int -> list -> list
setl(n, v, cons(m, l)) -> cons(v, l) | n = 0
setl(n, v, cons(m, l)) -> cons(m, setl(n-1, v, l)) | n > 0

/* Get from graph */
getg :: Int -> graph -> list
getg(n, consG(l, g)) -> l | n = 0
getg(n, consG(l, g)) -> getg(n-1, g) | n > 0

c :: Int -> Int -> Int -> Int -> Int -> Int

/* Memory functions */

/* filling the range in the memory with the value */
fillRange :: Int -> Int -> Int -> Bool
fillRange1 :: Int -> Int -> Int -> Bool -> Bool

fillRange(start, end, val) -> fillRange1(start, end, val, SET(start, val)) | start <= end
fillRange(start, end, val) -> true | start > end
fillRange1(start, end, val, false) -> false
fillRange1(start, end, val, true) -> fillRange(start + 1, end, val)

/* Read range - reads a range from memory and returns a list with the corresponding memory values */
readRange :: Int -> Int -> list
readRange1 :: Int -> Int -> list -> list
readRange(start, end) -> readRange1(start, end, nil)
readRange1(start, end, l) -> cons(GET(start), readRange1(start + 1, end, l)) | start <= end
readRange1(start, end, l) -> l | start > end

/* bfs */
/* graph, currentNode */
bfs :: graph -> Int -> list

/* graph, stack, position for WRITE call */
bfs1 :: graph -> list -> Bool -> list

/* graph, currentNode, stack */
bfs2 :: graph -> Int -> list -> list

/* graph, currentNode, stack, node neighbours, position for WRITE call */
bfs3 :: graph -> Int -> list -> list -> Bool -> list

/* graph, currentNode, stack, visitedNodes, node neighbours, is neighbour visited */
bfs4 :: graph -> Int -> list -> list -> Int -> list

/* bfs algorithm */
bfs(graph, start) -> bfs1(graph, cons(start, nil), fillRange(0, numNodes(graph), 0))

/* Stack with nodes is empty - return the list of visited nodes */
bfs1(graph, nil, true) -> readRange(0, numNodes(graph))

/* Stack with nodes is not empty - proceed with the algorithm */
bfs1(graph, cons(x, stk), true) -> bfs2(graph, x, stk)

/* Starting processing neighbours of the node x */
bfs2(graph, x, stk) -> bfs3(graph, x, stk, getg(x, graph), SET(x, 1))

/* Neighbours list is empty - return to pick node from the stack */
bfs3(graph, x, stk, nil, true) -> bfs1(graph, stk, true)

/* Neighbours list is not empty - process the next one */
bfs3(graph, x, stk, cons(u, l), true) ->
    bfs4(graph, x, stk, cons(u, l), GET(u))

/* Neighbour node is not visited - add node to the stack */
bfs4(graph, x, stk, cons(u, l), 0) ->
    bfs3(graph, x, cons(u, stk), l, true)

/* Neighbour node is visited - move to the next one */
bfs4(graph, x, stk, cons(u, l), 1) -> bfs3(graph, x, stk, l, true)

/* Example list: [1, 2, 3, 4] */
list1 :: list
list1 -> cons(1, cons(2, cons(3, cons(4, nil))))

/* Example graph:
   (1) --> (2)
    |       ^
    |       |
    |    > (5)
    |   /
    |  /
    v /
   (3) --> (4) */
graph1 :: graph
graph1 -> consG(                    /* 1 */
            cons(1, cons(2, nil)),
          consG(nil,                /* 2 */
          consG(                    /* 3 */
            cons(3, cons(4, nil)),
          consG(nil,                /* 4 */
          consG(                    /* 5 */
            cons(1, nil),
          nilG)))))
graph2 :: graph
graph2 -> consG(cons(1, nil),
          consG(cons(2, nil),
          consG(cons(3, nil),
          consG(cons(0, nil),
          consG(cons(2, nil),
          consG(cons(4, nil),
          consG(cons(5, cons(7, nil)),
          consG(nil,
          consG(cons(9, nil),
          consG(cons(7, cons(10, nil)),
          consG(cons(8, nil),
          nilG)))))))))))

c1 :: Int -> Bool -> list
c2 :: list -> Int

c1(x, true) -> readRange(0, 10)