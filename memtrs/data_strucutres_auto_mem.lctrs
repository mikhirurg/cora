/* =================================== MEMTRS KERNEL ============================================ */

READ :: Int
WRITE :: Int -> Bool

GET :: Int -> Int
SET :: Int -> Int -> Bool

alloc :: Int -> Int
alloc1 :: Int -> Int -> Int
alloc2 :: Int -> Bool -> Int
alloc(size) -> alloc1(size, GET(0))
alloc1(size, freshAddr) -> alloc2(freshAddr, SET(0, freshAddr + size))
alloc2(addr, true) -> addr

/* ============================================================================================== */

/* ================================== HELPER FUNCTIONS ========================================== */

min :: Int -> Int -> Int
min(x, y) -> x | x <= y
min(x, y) -> y | y < x

max :: Int -> Int -> Int
max(x, y) -> x | x >= y
max(x, y) -> y | y > x

/* ============================================================================================== */

/* ================================= TERM DATA STRUCTURES ======================================= */

/* ==================================== TERMS: LIST ============================================= */

/* list data structure */
nil :: list
cons :: Int -> list -> list

/* list size */
listLen :: list -> Int
listLen(nil) -> 0
listLen(cons(e, l)) -> 1 + listLen(l)

/* Set value in the list */
setl :: Int -> Int -> list -> list
setl(n, v, cons(m, l)) -> cons(v, l) | n = 0
setl(n, v, cons(m, l)) -> cons(m, setl(n-1, v, l)) | n > 0

/* Get from list */
getl :: Int -> list -> Int
getl(n, cons(m, l)) -> m | n = 0
getl(n, cons(m, l)) -> getl(n-1, l) | n > 0

/* genList */
genList :: Int -> list
genList(n) -> nil | n = 0
genList(n) -> cons(0, genList(n-1)) | n > 0

/* Read range - reads a range from memory and returns a list with the corresponding memory values */
readRange :: Int -> Int -> list
readRange1 :: Int -> Int -> list -> list
readRange(start, end) -> readRange1(start, end, nil)
readRange1(start, end, l) -> cons(GET(start), readRange1(start + 1, end, l)) | start <= end
readRange1(start, end, l) -> l | start > end

/* ============================================================================================== */

/* ==================================== TERMS: GRAPH ============================================ */

/* graph data structure */
nilG :: graph
consG :: list -> graph -> graph

/* number of nodes in graph */
numNodes :: graph -> Int
numNodes(nilG) -> 0
numNodes(consG(l, g)) -> 1 + numNodes(g)

/* Fill */
fill :: list -> Int -> list
fill(nil, a) -> nil
fill(cons(a, l), v) -> cons(v, fill(l, v))

/* Get from graph */
getg :: Int -> graph -> list
getg(n, consG(l, g)) -> l | n = 0
getg(n, consG(l, g)) -> getg(n-1, g) | n > 0

/* ============================================================================================== */

/* ============================= IN-MEMORY DATA STRUCTURES ====================================== */

/* ================================== IN-MEM DS: ARRAY ========================================== */

/* Create Array */

/* signature: size -> Bool */
createArray :: Int -> Int
createArray1 :: Int -> Int -> Int
createArray2 :: Int -> Int -> Bool -> Int
createArray3 :: Int -> Int -> Int -> Int
createArray4 :: Int -> Int -> Int -> Bool -> Int
createArray(size) -> createArray1(alloc(size + 1), size)
createArray1(addr, size) -> createArray2(addr, size, SET(addr, size))
createArray2(addr, size, true) -> createArray3(addr, addr + 1, size) | size > 0
createArray3(arrAddr, addr, size) ->
    createArray4(arrAddr, addr + 1, size - 1, SET(addr, 0)) | size > 0
createArray3(arrAddr, addr, size) -> arrAddr | size <= 0
createArray4(arrAddr, addr, size, true) -> createArray3(arrAddr, addr, size)

/* ACCESS Array element */
/* addr -> index -> value */
getArr :: Int -> Int -> Int
getArr1 :: Int -> Int -> Int -> Int
getArr(addr, i) -> getArr1(addr, i, GET(addr))
getArr1(addr, i, size) -> GET(addr + i + 1) | i < size

/* SET Array element */
/* addr -> index -> value -> is successful? */
setArr :: Int -> Int -> Int -> Bool
setArr1 :: Int -> Int -> Int -> Int -> Bool
setArr(addr, i, value) -> setArr1(addr, i, value, GET(addr))
setArr1(addr, i, value, size) -> SET(addr + i + 1, value) | i < size
setArr1(addr, i, value, size) -> false | i >= size

/* Get Array size */
getArrSize :: Int -> Int
getArrSize(addr) -> GET(addr)

/* Swap Array elements */
/* addr -> i1 -> i2 -> Bool */
swapArr :: Int -> Int -> Int -> Bool
swapArr1 :: Int -> Int -> Int -> Int -> Bool
swapArr2 :: Int -> Int -> Int -> Int -> Int -> Bool
swapArr3 :: Bool -> Bool -> Bool
swapArr(addr, i1, i2) -> swapArr1(addr, i1, i2, GET(addr))
swapArr1(addr, i1, i2, size) -> false | (i1 >= size) \/ (i2 >= size)
swapArr1(addr, i1, i2, size) ->
    swapArr2(addr, i1, i2, GET(addr + i1 + 1), GET(addr + i2 + 1)) | (i1 < size) /\ (i2 < size)
swapArr2(addr, i1, i2, val1, val2) -> swapArr3(SET(addr + i2 + 1, val1), SET(addr + i1 + 1, val2))
swapArr3(status1, status2) -> true | status1 /\ status2
swapArr3(status1, status2) -> false | not(status1 /\ status2)

/* Array to List */
arrayToList :: Int -> list
arrayToList1 :: Int -> Int -> list
arrayToList(addr) -> arrayToList1(addr, GET(addr))
arrayToList1(addr, size) -> readRange(addr + 1, addr + size)

/* List to Array */
listToArray :: list -> Int
listToArray1 :: list -> Int -> Int -> Int
listToArray2 :: list -> Int -> Int -> Int -> Int
listToArray3 :: list -> Int -> Int -> Int -> Bool -> Int
listToArray(l) -> listToArray1(l, createArray(listLen(l)), listLen(l))
listToArray1(l, addr, size) -> listToArray2(l, addr, size, 0)
listToArray2(cons(el, l), addr, size, i) ->
    listToArray3(l, addr, size, i, setArr(addr, i, el)) | i < size
listToArray3(l, addr, size, i, true) -> listToArray2(l, addr, size, i + 1)
listToArray2(nil, addr, size, i) -> addr

/* ============================================================================================== */

/* ================================= IN-MEM DS: MIN HEAP ======================================== */

/* create min heap */
createMinHeap :: Int -> Int
createMinHeap1 :: Int -> Int
createMinHeap2 :: Int -> Bool -> Int
createMinHeap(cap) -> createMinHeap1(createArray(cap + 1))
createMinHeap1(addr) -> createMinHeap2(addr, SET(addr, GET(addr) - 1))
createMinHeap2(addr, true) -> addr

/* Heap Sift down - transforming the heap to satisfy the heap properties */
/*
Used to fix the heap when some element value increases
If ith element is less than the smallest of the children,
we swap the element with the child, and perform this procedure again
*/
/* addr -> index -> status? */
heapSiftDown :: Int -> Int -> Bool
heapSiftDown1 :: Int -> Int -> Int -> Bool
heapSiftDown2 :: Int -> Int -> Int -> Int -> Bool
heapSiftDown3 :: Int -> Int -> Int -> Int -> Int -> Bool
heapSiftDown4 :: Int -> Int -> Int -> Int -> Int -> Int -> Bool
heapSiftDown5 :: Int -> Int -> Int -> Bool -> Bool

heapSiftDown(addr, i) -> heapSiftDown1(addr, i, GET(addr))
heapSiftDown1(addr, 0, 0) -> true
heapSiftDown1(addr, i, size) -> false | i >= size /\ size > 0
heapSiftDown1(addr, i, size) -> true | 2 * i + 1 >= size
heapSiftDown1(addr, i, size) ->
    heapSiftDown2(addr, i, size, getArr(addr, 2 * i + 1)) | 2 * i + 1 < size
heapSiftDown2(addr, i, size, left) ->
    heapSiftDown3(addr, i, size, left, getArr(addr, 2 * i + 2)) | 2 * i + 2 < size
heapSiftDown2(addr, i, size, left) ->
    heapSiftDown4(addr, i, size, 2 * i + 1, left, getArr(addr, i)) | 2 * i + 2 >= size
heapSiftDown3(addr, i, size, left, right) ->
    heapSiftDown4(addr, i, size, 2 * i + 1, left, getArr(addr, i)) | right >= left
heapSiftDown3(addr, i, size, left, right) ->
    heapSiftDown4(addr, i, size, 2 * i + 2, right, getArr(addr, i)) | right < left
heapSiftDown4(addr, i, size, childIndex, childVal, nodeVal) -> true | nodeVal <= childVal
heapSiftDown4(addr, i, size, childIndex, childVal, nodeVal) ->
    heapSiftDown5(addr, i, childIndex, swapArr(addr, i, childIndex))
heapSiftDown5(addr, i, childIndex, true) -> heapSiftDown(addr, childIndex)
heapSiftDown5(addr, i, childIndex, false) -> false

/* Heap Sift up */
/* If some element is smaller than the parent node, we swap them,
then we perform this operation for the parent */
heapSiftUp :: Int -> Int -> Bool
heapSiftUp1 :: Int -> Int -> Int -> Bool
heapSiftUp2 :: Int -> Int -> Int -> Int -> Int -> Bool
heapSiftUp3 :: Int -> Int -> Bool -> Bool
heapSiftUp(addr, i) -> true | i <= 0
heapSiftUp(addr, i) -> heapSiftUp1(addr, i, GET(addr)) | i > 0
heapSiftUp1(addr, i, size) -> false | i >= size
heapSiftUp1(addr, i, size) ->
    heapSiftUp2(addr, i, size, getArr(addr, i), getArr(addr, (i - 1) / 2)) | i < size
heapSiftUp2(addr, i, size, nodeVal, parentVal) -> true | nodeVal >= parentVal
heapSiftUp2(addr, i, size, nodeVal, parentVal) ->
    heapSiftUp3(addr, i, swapArr(addr, i, (i - 1) / 2)) | nodeVal < parentVal
heapSiftUp3(addr, i, true) -> heapSiftUp(addr, (i - 1) / 2)
heapSiftUp3(addr, i, false) -> false

/* Heap insert */
heapInsert :: Int -> Int -> Bool
heapInsert1 :: Int -> Int -> Int -> Int -> Bool
heapInsert2 :: Int -> Int -> Int -> Bool -> Bool
heapInsert3 :: Int -> Int -> Int -> Bool -> Bool
heapInsert(addr, el) -> heapInsert1(addr + 1, el, GET(addr), GET(addr + 1))
heapInsert1(addr, el, cap, size) -> heapInsert2(addr, el, size, SET(addr, size + 1)) | size < cap
heapInsert1(addr, el, cap, size) -> false | size >= cap
heapInsert2(addr, el, size, false) -> false
heapInsert2(addr, el, size, true) -> heapInsert3(addr, el, size, setArr(addr, size, el))
heapInsert3(addr, el, size, false) -> false
heapInsert3(addr, el, size, true) -> heapSiftUp(addr, size)

/* Heap extract minimum */
heapExtractMin :: Int -> Int
heapExtractMin1 :: Int -> Int -> Int -> Int
heapExtractMin2 :: Int -> Int -> Int -> Bool -> Int
heapExtractMin3 :: Int -> Int -> Bool -> Int
heapExtractMin4 :: Int -> Int -> Bool -> Int
heapExtractMin(addr) -> heapExtractMin1(addr + 1, getArr(addr + 1, 0), GET(addr + 1))
heapExtractMin1(addr, minVal, size) ->
    heapExtractMin2(addr, minVal, size, setArr(addr, 0, getArr(addr, size - 1)))
heapExtractMin2(addr, minVal, size, true) ->
    heapExtractMin3(addr, minVal, SET(addr, size - 1))
heapExtractMin3(addr, minVal, true) -> heapExtractMin4(addr, minVal, heapSiftDown(addr, 0))
heapExtractMin4(addr, minVal, true) ->  minVal

/* Heap to list */
heapToList :: Int -> list
heapToList(addr) -> arrayToList(addr + 1)

/* ================================== IN-MEM DS: MATRIX ========================================= */

createMatrix :: Int -> Int -> Int
createMatrix1 :: Int -> Int -> Int
createMatrix2 :: Int -> Int -> Int -> Int
createMatrix3 :: Int -> Int -> Int -> Int -> Int
createMatrix4 :: Bool -> Int -> Int -> Int -> Int -> Int
createMatrix(w, h) -> createMatrix1(createArray(w), h)
createMatrix1(arrsAddr, h) -> createMatrix2(arrsAddr, h, 0)
createMatrix2(arrsAddr, h, i) -> createMatrix3(createArray(h), arrsAddr, h, i)
createMatrix3(addr, arrsAddr, h, i) ->
    createMatrix4(setArr(arrsAddr, i, addr), addr, arrsAddr, h, i)
createMatrix4(true, addr, arrsAddr, h, i) -> createMatrix2(arrsAddr, h, i + 1) | i < h - 1
createMatrix4(true, addr, arrsAddr, h, i) -> arrsAddr | i >= h - 1

/* Get matrix width */
getMatrixWidth :: Int -> Int
getMatrixWidth(addr) -> getArrSize(addr)

/* Get matrix height */
getMatrixHeight :: Int -> Int
getMatrixHeight(addr) -> getArrSize(getArr(addr, 0))

/* Get element from matrix */
getMatrix :: Int -> Int -> Int -> Int
getMatrix1 :: Int -> Int -> Int -> Int -> Int -> Int
getMatrix(addr, x, y) -> getMatrix1(addr, getMatrixWidth(addr), getMatrixHeight(addr), x, y)
getMatrix1(addr, width, height, x, y) ->
    getArr(getArr(addr, x), y) | 0 <= x /\ x < width /\ 0 <= y /\ y < height

/* Set element in matrix */
setMatrix :: Int -> Int -> Int -> Int -> Bool
setMatrix1 :: Int -> Int -> Int -> Int -> Int -> Int -> Bool
setMatrix(addr, x, y, val) ->
    setMatrix1(addr, getMatrixWidth(addr), getMatrixHeight(addr), x, y, val)
setMatrix1(addr, width, height, x, y, val) ->
    setArr(getArr(addr, x), y, val) | 0 <= x /\ x < width /\ 0 <= y /\ y < height

/* Graph to Matrix */
graphToMatrix :: graph -> Int
graphToMatrix1 :: graph -> Int -> Int
graphToMatrix2 :: graph -> Int -> Int -> Int
graphToMatrix3 :: graph -> list -> Int -> Int -> Int -> Int
graphToMatrix4 :: graph -> list -> Int -> Int -> Int -> Bool -> Int
graphToMatrix(graph) -> graphToMatrix1(graph, numNodes(graph))
graphToMatrix1(graph, size) -> graphToMatrix2(graph, createMatrix(size, size), 0)
graphToMatrix2(consG(l, graph), addr, i) ->
    graphToMatrix3(graph, l, addr, i, 0)
graphToMatrix2(nilG, addr, i) -> addr
graphToMatrix3(graph, cons(x, l), addr, i, j) ->
    graphToMatrix4(graph, l, addr, i, j, setMatrix(addr, i, j, 1))
graphToMatrix3(graph, nil, addr, i, j) -> graphToMatrix2(graph, addr, i + 1)
graphToMatrix4(graph, l, addr, i, j, true) ->
    graphToMatrix3(graph, l, addr, i, j + 1)

/* ============================================================================================== */

/* ===================================== ALGORITHMS ============================================= */

/* Heap sort */
heapSort :: Int -> Bool
heapSort1 :: Int -> Int -> Int -> Bool
heapSort2 :: Int -> Int -> Int -> Int -> Bool
heapSort3 :: Int -> Int -> Int -> Int -> Bool -> Bool
heapSort4 :: Int -> Int -> Int -> Bool
heapSort5 :: Int -> Int -> Int -> Int -> Bool
heapSort6 :: Int -> Int -> Int -> Int -> Bool -> Bool
heapSort(addr1) ->
    heapSort1(addr1, createMinHeap(getArrSize(addr1)), getArrSize(addr1))
heapSort1(addr1, addr2, size) -> heapSort2(addr1, addr2, size, 0)
heapSort2(addr1, addr2, size, i) ->
    heapSort3(addr1, addr2, size, i, heapInsert(addr2, getArr(addr1, i))) | i < size
heapSort3(addr1, addr2, size, i, false) -> false
heapSort3(addr1, addr2, size, i, true) -> heapSort2(addr1, addr2, size, i + 1)
heapSort2(addr1, addr2, size, i) -> heapSort4(addr1, addr2, size) | i >= size
heapSort4(addr1, addr2, size) -> heapSort5(addr1, addr2, size, 0)
heapSort5(addr1, addr2, size, i) ->
    heapSort6(addr1, addr2, size, i, setArr(addr1, i, heapExtractMin(addr2))) | i < size
heapSort6(addr1, addr2, size, i, false) -> false
heapSort6(addr1, addr2, size, i, true) -> heapSort5(addr1, addr2, size, i + 1)
heapSort5(addr1, addr2, size, i) -> true | i >= size

/* Quick Sort */
qSortPartition :: Int -> Int -> Int -> Int
qSortPartition1 :: Int -> Int -> Int -> Int -> Int
qSortPartition2 :: Int -> Int -> Int -> Int -> Int -> Int -> Int
qSortPartition3 :: Int -> Int -> Int -> Int -> Bool -> Int
qSortPartition4 :: Int -> Int -> Int -> Int -> Bool -> Int
qSortPartition(addr, l, r) -> qSortPartition1(addr, l, r, l)
qSortPartition1(addr, l, r, i) ->
    qSortPartition2(addr, l, r, i, getArr(addr, l), getArr(addr, r - 1)) | l < r - 1
qSortPartition2(addr, l, r, i, val1, val2) ->
    qSortPartition3(addr, l, r, i, swapArr(addr, i, l)) | val1 <= val2
qSortPartition3(addr, l, r, i, true) -> qSortPartition1(addr, l + 1, r, i + 1)
qSortPartition2(addr, l, r, i, val1, val2) ->
    qSortPartition1(addr, l + 1, r, i) | val1 > val2
qSortPartition1(addr, l, r, i) ->
    qSortPartition4(addr, l, r, i, swapArr(addr, i, r - 1)) | l >= r - 1
qSortPartition4(addr, l, r, i, true) -> i

qSort :: Int -> Int -> Int -> Bool
qSort1 :: Int -> Int -> Int -> Int -> Bool
qSort2 :: Bool -> Bool -> Bool
qSort(addr, l, r) -> true | r - l <= 1
qSort(addr, l, r) -> qSort1(addr, l, r, qSortPartition(addr, l, r)) | r - l > 1
qSort1(addr, l, r, q) -> qSort2(qSort(addr, l, q), qSort(addr, q + 1, r))
qSort2(left, right) -> left /\ right

/* bfs */
/* graph, currentNode */
bfs :: graph -> Int -> Int
bfs1 :: graph -> Int -> Int -> Int
bfs2 :: graph -> list -> Int -> Int
bfs3 :: graph -> Int -> Int -> list -> Int
bfs4 :: graph -> Int -> Int -> list -> list -> Bool -> Int
bfs5 :: graph -> Int -> Int -> list -> list -> Int -> Int

bfs(graph, start) -> bfs1(graph, start, createArray(numNodes(graph)))
bfs1(graph, start, addr) -> bfs2(graph, cons(start, nil), addr)
bfs2(graph, nil, addr) -> addr
bfs2(graph, cons(x, stk), addr) -> bfs3(graph, addr, x, stk)
bfs3(graph, addr, x, stk) -> bfs4(graph, addr, x, stk, getg(x, graph), setArr(addr, x, 1))
bfs4(graph, addr, x, stk, nil, true) -> bfs2(graph, stk, addr)
bfs4(graph, addr, x, stk, cons(u, l), true) ->
    bfs5(graph, addr, x, stk, cons(u, l), getArr(addr, u))
bfs5(graph, addr, x, stk, cons(u, l), 0) -> bfs4(graph, addr, x, cons(u, stk), l, true)
bfs5(graph, addr, x, stk, cons(u, l), 1) -> bfs4(graph, addr, x, stk, l, true)

/* bfs: multi-core (2 cores) */
mc_bfs :: graph -> Int -> Int
mc_bfs1 :: graph -> Int -> Int -> Int
mc_bfs2 :: graph -> list -> Int -> Int
mc_bfs3 :: graph -> Int -> Int -> list -> Int
mc_bfs4 :: graph -> Int -> Int -> list -> list -> Bool -> Int
mc_bfs5 :: graph -> Int -> Int -> list -> list -> Int -> Int
mc_bfs_env :: Int -> Int -> Int

mc_bfs(graph, start) -> mc_bfs1(graph, start, createArray(numNodes(graph)))
mc_bfs1(graph, start, addr) -> mc_bfs2(graph, cons(start, nil), addr)
mc_bfs2(graph, nil, addr) -> addr
mc_bfs2(graph, cons(x1, cons(x2, stk)), addr) ->
    mc_bfs_env(mc_bfs3(graph, addr, x1, stk), mc_bfs3(graph, addr, x2, stk))
mc_bfs2(graph, cons(x1, nil), addr) ->
    mc_bfs_env(mc_bfs3(graph, addr, x1, nil), addr)
mc_bfs3(graph, addr, x, stk) -> mc_bfs4(graph, addr, x, stk, getg(x, graph), setArr(addr, x, 1))
mc_bfs4(graph, addr, x, stk, nil, true) -> mc_bfs2(graph, stk, addr)
mc_bfs4(graph, addr, x, stk, cons(u, l), true) ->
    mc_bfs5(graph, addr, x, stk, cons(u, l), getArr(addr, u))
mc_bfs5(graph, addr, x, stk, cons(u, l), 0) -> mc_bfs4(graph, addr, x, cons(u, stk), l, true)
mc_bfs5(graph, addr, x, stk, cons(u, l), 1) -> mc_bfs4(graph, addr, x, stk, l, true)

mc_bfs_env(addr, addr) -> addr

