/* ===================================== TESTS ================================================== */

c1 :: Int -> Bool -> Bool
c2 :: Bool -> Bool

c1(x, true) -> c2(setArr(0, 1, 15))
c2(true) -> swapArr(0, 1, 2)

exec0 :: list
exec1 :: Bool -> list
exec2 :: Int -> list
exec3 :: Int -> Bool -> list
exec4 :: Int -> Bool -> list
exec5 :: Int -> Bool -> list
exec6 :: Int -> Bool -> list
exec7 :: Int -> Int -> list
exec8 :: Int -> Int -> list
exec9 :: Int -> Int -> list
exec0 -> exec1(SET(0, 1))
exec1(true) -> exec2(createMinHeap(4))
exec2(addr) -> exec3(addr, heapInsert(addr, 3))
exec3(addr, true) -> exec4(addr, heapInsert(addr, 6))
exec4(addr, true) -> exec5(addr, heapInsert(addr, 2))
exec5(addr, true) -> exec6(addr, heapInsert(addr, 4))
exec6(addr, true) -> exec7(addr, heapExtractMin(addr))
exec7(addr, 2) -> exec8(addr, heapExtractMin(addr))
exec8(addr, 3) -> exec9(addr, heapExtractMin(addr))
exec9(addr, 4) -> heapToList(addr)

e0 :: list -> list
e1 :: list -> Bool -> list
e2 :: Int -> Int -> list
e3 :: Int -> Bool -> list
e0(l) -> e1(l, SET(0, 1))
e1(l, true) -> e2(listLen(l), listToArray(l))
e2(size, addr) -> e3(addr, heapSort(addr))
e3(addr, true) -> arrayToList(addr)

ex0 :: list -> list
ex1 :: list -> Bool -> list
ex2 :: Int -> Int -> list
ex3 :: Int -> Bool -> list
ex0(l) -> ex1(l, SET(0, 1))
ex1(l, true) -> ex2(listLen(l), listToArray(l))
ex2(size, addr) -> ex3(addr, qSort(addr, 0, size))
ex3(addr, true) -> arrayToList(addr)

test4_e0 :: Int -> Int -> Int
test4_e1 :: Int -> Int -> Bool -> Int
test4_e2 :: Int -> Int
test4_e3 :: Int -> Bool -> Int
test4_e0(w, h) -> test4_e1(w, h, SET(0, 1))
test4_e1(w, h, true) -> test4_e2(createMatrix(w, h))
test4_e2(addr) -> test4_e3(addr, setMatrix(addr, 1, 0, 15))
test4_e3(addr, true) -> getMatrix(addr, 1, 0)

test5_e0 :: graph -> Int -> list
test5_e1 :: graph -> Int -> Bool -> list
test5_e0(g, v) -> test5_e1(g, v, SET(0, 1))
test5_e1(g, v, true) -> arrayToList(bfs(g, v))

test6_e0 :: graph -> Int -> list
test6_e1 :: graph -> Int -> Bool -> list
test6_e0(g, v) -> test6_e1(g, v, SET(0, 1))
test6_e1(g, v, true) -> arrayToList(mc_bfs(g, v))

test7_e0 :: graph -> Int
test7_e1 :: graph -> Bool -> Int
test7_e2 :: Int -> Int
test7_e0(g) -> test7_e1(g, SET(0, 1))
test7_e1(g, true) -> test7_e2(graphToMatrix(g))