/* =================================== MEMTRS KERNEL ============================================ */

READ :: Int
WRITE :: Int -> Bool

GET :: Int -> Int
SET :: Int -> Int -> Bool

alloc :: Int -> Int
alloc1 :: Int -> Int -> Int
alloc2 :: Int -> Bool -> Int
alloc(size) -> alloc1(size, GET(0))
alloc1(size, freshAddr) -> alloc2(freshAddr, SET(0, freshAddr + size))
alloc2(addr, true) -> addr

/* ============================================================================================== */