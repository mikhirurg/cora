#include array.lctrs
#include ../term_ds/graph.lctrs
#include ../term_ds/matrix_term.lctrs

/* ================================== IN-MEM DS: MATRIX ========================================= */

createMatrix :: Int -> Int -> Int
createMatrix1 :: Int -> Int -> Int
createMatrix2 :: Int -> Int -> Int -> Int
createMatrix3 :: Int -> Int -> Int -> Int -> Int
createMatrix4 :: Bool -> Int -> Int -> Int -> Int -> Int
createMatrix(w, h) -> createMatrix1(createArray(w), h)
createMatrix1(arrsAddr, h) -> createMatrix2(arrsAddr, h, 0)
createMatrix2(arrsAddr, h, i) -> createMatrix3(createArray(h), arrsAddr, h, i)
createMatrix3(addr, arrsAddr, h, i) ->
    createMatrix4(setArr(arrsAddr, i, addr), addr, arrsAddr, h, i)
createMatrix4(true, addr, arrsAddr, h, i) -> createMatrix2(arrsAddr, h, i + 1) | i < h - 1
createMatrix4(true, addr, arrsAddr, h, i) -> arrsAddr | i >= h - 1

/* Get matrix width */
getMatrixWidth :: Int -> Int
getMatrixWidth(addr) -> getArrSize(addr)

/* Get matrix height */
getMatrixHeight :: Int -> Int
getMatrixHeight(addr) -> getArrSize(getArr(addr, 0))

/* Get element from matrix */
getMatrix :: Int -> Int -> Int -> Int
getMatrix1 :: Int -> Int -> Int -> Int -> Int -> Int
getMatrix(addr, x, y) -> getMatrix1(addr, getMatrixWidth(addr), getMatrixHeight(addr), x, y)
getMatrix1(addr, width, height, x, y) ->
    getArr(getArr(addr, x), y) | 0 <= x /\ x < width /\ 0 <= y /\ y < height

/* Set element in matrix */
setMatrix :: Int -> Int -> Int -> Int -> Bool
setMatrix1 :: Int -> Int -> Int -> Int -> Int -> Int -> Bool
setMatrix(addr, x, y, val) ->
    setMatrix1(addr, getMatrixWidth(addr), getMatrixHeight(addr), x, y, val)
setMatrix1(addr, width, height, x, y, val) ->
    setArr(getArr(addr, x), y, val) | 0 <= x /\ x < width /\ 0 <= y /\ y < height

/* Fill Matrix */
fillMatrix :: Int -> Int -> Bool
fillMatrix1 :: Int -> Int -> Int -> Int -> Bool
fillMatrix2 :: Int -> Int -> Int -> Int -> Bool -> Bool
fillMatrix(addr, val) -> fillMatrix1(addr, val, getMatrixWidth(addr), 0)
fillMatrix1(addr, val, width, i) ->
    fillMatrix2(addr, val, width, i, fillArray(getArr(addr, i), val)) | i < width
fillMatrix2(addr, val, width, i, true) -> fillMatrix1(addr, val, width, i + 1)
fillMatrix1(addr, val, width, i) -> true | i >= width

fillMatrixDiag :: Int -> Int -> Bool
fillMatrixDiag1 :: Int -> Int -> Int -> Int -> Bool
fillMatrixDiag2 :: Int -> Int -> Int -> Int -> Bool -> Bool
fillMatrixDiag(addr, val) -> fillMatrixDiag1(addr, val, getMatrixWidth(addr), 0)
fillMatrixDiag1(addr, val, width, i) ->
    fillMatrixDiag2(addr, val, width, i, setMatrix(addr, i, i, val)) | i < width
fillMatrixDiag2(addr, val, width, i, true) -> fillMatrixDiag1(addr, val, width, i + 1)
fillMatrixDiag1(addr, val, width, i) -> true | i >= width

/* Matrix to Term */
matrixToTerm :: Int -> matrix
matrixToTerm1 :: Int -> Int -> Int -> matrix -> matrix
matrixToTerm2 :: Int -> Int -> Int -> matrix -> matrix
matrixToTerm(addr) -> matrixToTerm1(addr, getMatrixWidth(addr), 0, rowNil)
matrixToTerm1(addr, size, i, m) ->
    row(arrayToList(getArr(addr, i)), matrixToTerm2(addr, size, i, m)) | i < size
matrixToTerm2(addr, size, i, m) -> matrixToTerm1(addr, size, i + 1, m)
matrixToTerm1(addr, size, i, m) -> m | i >= size

/* Graph to Matrix */
graphToMatrix :: graph -> Int -> Int
graphToMatrix1 :: graph -> Int -> Int -> Int
graphToMatrix2 :: graph -> Int -> Int -> Int -> Int
graphToMatrix3 :: graph -> Int -> Int -> Bool -> Int
graphToMatrix4 :: graph -> list -> Int -> Int -> Int
graphToMatrix5 :: graph -> list -> Int -> Int -> Bool -> Int
graphToMatrix(graph, default) -> graphToMatrix1(graph, default, numNodes(graph))
graphToMatrix1(graph, default, size) -> graphToMatrix2(graph, default, createMatrix(size, size), 0)
graphToMatrix2(graph, default, addr, i) ->
    graphToMatrix3(graph, addr, i, fillMatrix(addr, default))
graphToMatrix3(consG(l, graph), addr, i, true) ->
    graphToMatrix4(graph, l, addr, i)
graphToMatrix3(nilG, addr, i, true) -> addr
graphToMatrix4(graph, cons(x, l), addr, i) ->
    graphToMatrix5(graph, l, addr, i, setMatrix(addr, i, x, 1))
graphToMatrix4(graph, nil, addr, i) -> graphToMatrix3(graph, addr, i + 1, true)
graphToMatrix5(graph, l, addr, i, true) -> graphToMatrix4(graph, l, addr, i)
