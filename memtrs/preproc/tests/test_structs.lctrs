#include ../stdlib/term_ds.lctrs

/* Example graph:
   (1) --> (2)
    |       ^
    |       |
    |    > (5)
    |   /
    |  /
    v /
   (3) --> (4) */
graph1 :: graph
graph1 -> consG(                    /* 1 */
            cons(1, cons(2, nil)),
          consG(nil,                /* 2 */
          consG(                    /* 3 */
            cons(3, cons(4, nil)),
          consG(nil,                /* 4 */
          consG(                    /* 5 */
            cons(1, nil),
          nilG)))))
graph2 :: graph
graph2 -> consG(cons(1, nil),
          consG(cons(2, nil),
          consG(cons(3, nil),
          consG(cons(0, nil),
          consG(cons(2, nil),
          consG(cons(4, nil),
          consG(cons(5, cons(7, nil)),
          consG(nil,
          consG(cons(9, nil),
          consG(cons(7, cons(10, nil)),
          consG(cons(8, nil),
          nilG)))))))))))