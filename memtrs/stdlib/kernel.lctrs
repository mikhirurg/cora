/* =================================== MEMTRS KERNEL ============================================ */

READ :: Int
WRITE :: Int -> Bool

GET :: Int -> Int
SET :: Int -> Int -> Bool
CAS :: Int -> Int -> Int -> Bool

alloc :: Int -> Int
alloc1 :: Int -> Int -> Bool -> Int
alloc2 :: Int -> Bool -> Int
alloc3 :: Int -> Bool -> Int
alloc(size) -> alloc1(size, GET(0), CAS(1, 0, 1))
alloc1(size, freshAddr, true) -> alloc2(freshAddr, SET(0, freshAddr + size)) | freshAddr = freshAddr
alloc1(size, freshAddr, false) -> alloc(size)
alloc2(addr, true) -> alloc3(addr, SET(1, 0))
alloc3(addr, true) -> addr

/* ============================================================================================== */