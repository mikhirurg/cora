/* =================================== MEMTRS KERNEL ============================================ */

GET :: Int -> Int
SET :: Int -> Int -> Bool
CAS :: Int -> Int -> Int -> Bool

alloc :: Int -> Int
allocLock :: Int -> Bool -> Int
allocRead :: Int -> Int -> Int
allocReserve :: Int -> Bool -> Int
allocUnlock :: Int -> Bool -> Int

alloc(size) -> allocLock(size, CAS(1, 0, 1)) | size > 0
alloc(size) -> -1 | size <= 0
allocLock(size, false) -> alloc(size) | true
allocLock(size, true) -> allocRead(size, GET(0)) | true
allocRead(size, fresh) -> allocReserve(fresh, SET(0, fresh + size)) | true
allocReserve(addr, true) -> allocUnlock(addr, SET(1, 0)) | true
allocUnlock(addr, true) -> addr | true

/* ============================================================================================== */