#include list.lctrs

/* ==================================== TERMS: GRAPH ============================================ */

/* unweighted graph data structure */
nilG :: graph
consG :: list -> graph -> graph

/* number of nodes in graph */
numNodes :: graph -> Int
numNodes(nilG) -> 0
numNodes(consG(l, g)) -> 1 + numNodes(g)

/* Fill */
fill :: list -> Int -> list
fill(nil, a) -> nil
fill(cons(a, l), v) -> cons(v, fill(l, v))

/* Get from graph */
getAdj :: Int -> graph -> list
getAdj(n, consG(l, g)) -> l | n = 0
getAdj(n, consG(l, g)) -> getAdj(n - 1, g) | n > 0