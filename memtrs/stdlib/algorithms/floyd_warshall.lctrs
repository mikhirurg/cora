#include ../mem_ds/array.lctrs
#include ../mem_ds/matrix.lctrs
#include ../term_ds/graph.lctrs
#include ../term_ds/matrix_term.lctrs
#include ../math.lctrs

floydWarshall :: graph -> Int
floydWarshallInit :: Int -> Int
floydWarshallZeroDiag :: Int -> Int -> Bool -> Int
floydWarshallLoopK :: Int -> Int -> Int -> Int -> Int -> Int
floydWarshallLoopI :: Int -> Int -> Int -> Int -> Int -> Int
floydWarshallLoopJ :: Int -> Int -> Int -> Int -> Int -> Int
floydWarshallStore :: Int -> Int -> Int -> Int -> Int -> Bool -> Int

floydWarshall(g) -> floydWarshallInit(graphToMatrix(g, numNodes(g) * 100))
floydWarshallInit(addr) ->
    floydWarshallZeroDiag(addr, getMatrixWidth(addr), fillMatrixDiag(addr, 0)) | addr >= 0
floydWarshallInit(addr) -> -1 | addr < 0
floydWarshallZeroDiag(addr, size, true) -> floydWarshallLoopK(addr, size, 0, 0, 0)
floydWarshallLoopK(addr, size, i, j, k) -> floydWarshallLoopI(addr, size, i, j, k) | k < size
floydWarshallLoopI(addr, size, i, j, k) -> floydWarshallLoopJ(addr, size, i, j, k) | i < size
floydWarshallLoopJ(addr, size, i, j, k) ->
    floydWarshallStore(addr, size, i, j, k,
        setMatrix(addr, i, j,
            min(getMatrix(addr, i, j), getMatrix(addr, i, k) + getMatrix(addr, k, j)))) | j < size
floydWarshallStore(addr, size, i, j, k, true) -> floydWarshallLoopJ(addr, size, i, j + 1, k)
floydWarshallLoopJ(addr, size, i, j, k) -> floydWarshallLoopI(addr, size, i + 1, 0, k) | j >= size
floydWarshallLoopI(addr, size, i, j, k) -> floydWarshallLoopK(addr, size, 0, j, k + 1) | i >= size
floydWarshallLoopK(addr, size, i, j, k) -> addr | k >= size

bnil :: blist
bcons :: Bool -> blist -> blist

/* parallel floyd warshall */
parFloydWarshall :: graph -> Int
parFloydWarshallAlloc :: graph -> Int -> Int
parFloydWarshallInitDiag :: Int -> Int -> Int -> Int
parFloydWarshallStart :: Int -> Int -> Int -> Bool -> Bool -> Int
parFloydWarshallLoopK :: Int -> Int -> Int -> Int -> Int
parFloydWarshallSync :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int
fwBlockWorker :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int
fwBlockContinue :: Int -> Int -> Int -> Int -> Int -> Int -> Int ->  Int -> Int -> Int -> Bool -> Int
fwUpdateCell :: Int -> Int -> Int -> Int -> Int -> Bool

/* 1) create 2 matrices: for previous step and current step */
parFloydWarshall(g) -> parFloydWarshallAlloc(g, numNodes(g))
parFloydWarshallAlloc(g, size) ->
    parFloydWarshallInitDiag(size, graphToMatrix(g, size * 100),
        graphToMatrix(g, size * 100)) | size >= 0
parFloydWarshallAlloc(g, size) -> -1 | size < 0
parFloydWarshallInitDiag(size, curr, next) ->
    parFloydWarshallStart(size, curr , next,
        fillMatrixDiag(curr, 0), fillMatrixDiag(next, 0)) | curr >= 0 /\ next >= 0
parFloydWarshallInitDiag(size, curr, next) -> -1 | curr < 0 \/ next < 0
/* 2) start outer loop to compute k steps of matrices, and schedule parallel workers */
parFloydWarshallStart(size, curr, next, true, true) ->
    parFloydWarshallLoopK(size, curr, next, 0)
parFloydWarshallLoopK(size, curr, next, k) ->
    parFloydWarshallSync(size, curr, next, k,
        fwBlockWorker(size, curr, next, k, 0, 0, size / 2, size / 2, 0, 0),
        fwBlockWorker(size, curr, next, k, size / 2, 0, size, size / 2, size / 2, 0),
        fwBlockWorker(size, curr, next, k, 0, size / 2, size / 2, size, 0, size / 2),
        fwBlockWorker(size, curr, next, k, size / 2, size / 2, size, size, size / 2, size / 2))
            | k < size
/* if we reached the end of k steps => return the address of the last computed matrix */
parFloydWarshallLoopK(size, curr, next, k) -> curr | k >= size
/* 3) run worker to process a matrix block in parallel */
fwBlockWorker(size, curr, next, k, rowStart, colStart, rowEnd, colEnd, i, j) ->
    fwBlockContinue(size, curr, next, k, rowStart, colStart, rowEnd, colEnd, i + 1, j,
        fwUpdateCell(curr, next, i, j, k)) | i < rowEnd /\ j < colEnd
fwBlockWorker(size, curr, next, k, rowStart, colStart, rowEnd, colEnd, i, j) ->
    fwBlockWorker(size, curr, next, k, rowStart, colStart, rowEnd, colEnd, rowStart, j + 1)
        | i >= rowEnd /\ j < colEnd
fwBlockWorker(size, curr, next, k, rowStart, colStart, rowEnd, colEnd, i, j) -> 1
        | j >= colEnd
fwBlockContinue(size, curr, next, k, rowStart, colStart, rowEnd, colEnd, i, j, true) ->
    fwBlockWorker(size, curr, next, k, rowStart, colStart, rowEnd, colEnd, i, j)
fwUpdateCell(curr, next, i, j, k) ->
    setMatrix(next, i, j,
        min(getMatrix(curr, i, j), getMatrix(curr, i, k) + getMatrix(curr, k, j)))
/* 4) wait for all workers to finish, swap distance matrices and continue computation */
parFloydWarshallSync(size, curr, next, k, 1, 1, 1, 1) ->
    parFloydWarshallLoopK(size, next, curr, k + 1)