/* parallel floyd warshall */
parFloydWarshall :: graph -> Int
parFloydWarshall1 :: graph -> Int -> Int
parFloydWarshall2 :: Int -> Int -> Int -> Int
parFloydWarshall3 :: Int -> Int -> Int -> Bool -> Bool -> Int
parFloydWarshall4 :: Int -> Int -> Int -> Int -> Int
parFloydWarshall5 :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int
worker :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int
worker1 :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Bool -> Int
compute_cell :: Int -> Int -> Int -> Int -> Int -> Bool
/* 1) create 2 matrices: for previous step and current step */
parFloydWarshall(g) -> parFloydWarshall1(g, numNodes(g))
parFloydWarshall1(g, size) ->
    parFloydWarshall2(size, graphToMatrix(g, size * 100), graphToMatrix(g, size * 100))
parFloydWarshall2(size, matrix1, matrix2) ->
    parFloydWarshall3(size, matrix1, matrix2,
        fillMatrixDiag(matrix1, 0), fillMatrixDiag(matrix2, 0))
/* 2) start outer loop to compute k steps of matrices, and schedule parallel workers */
parFloydWarshall3(size, matrix1, matrix2, true, true) ->
    parFloydWarshall4(size, matrix1, matrix2, 0)
parFloydWarshall4(size, matrix1, matrix2, k) ->
    parFloydWarshall5(size, matrix1, matrix2, k,
        worker(size, matrix1, matrix2, k, size / 2, size / 2, 0, 0),
        worker(size, matrix1, matrix2, k, size, size / 2, size / 2, 0),
        worker(size, matrix1, matrix2, k, size / 2, size, 0, size / 2),
        worker(size, matrix1, matrix2, k, size, size, size / 2, size / 2)) | k < size
/* if we reached the end of k steps => return the address of the last computed matrix */
parFloydWarshall4(size, matrix1, matrix2, k) -> matrix1 | k >= size
/* 3) run worker to process a matrix block in parallel */
worker(size, matrix1, matrix2, k, endX, endY, x, y) ->
    worker1(size, matrix1, matrix2, k, endX, endY, x + 1, y,
        compute_cell(matrix1, matrix2, x, y, k)) | x < endX /\ y < endY
worker(size, matrix1, matrix2, k, endX, endY, x, y) ->
    worker(size, matrix1, matrix2, k, endX, endY, 0, y + 1) | x >= endX /\ y < endY
worker(size, matrix1, matrix2, k, endX, endY, x, y) -> 1 | y >= endY
worker1(size, matrix1, matrix2, k, endX, endY, x, y, true) ->
    worker(size, matrix1, matrix2, k, endX, endY, x, y)
compute_cell(matrix1, matrix2, x, y, k) ->
    setMatrix(matrix2, x, y,
        min(getMatrix(matrix1, x, y), getMatrix(matrix1, x, k) + getMatrix(matrix1, k, y)))
/* 4) wait for all workers to finish, swap distance matrices and continue computation */
parFloydWarshall5(size, matrix1, matrix2, k, 1, 1, 1, 1) ->
    parFloydWarshall4(size, matrix2, matrix1, k + 1)