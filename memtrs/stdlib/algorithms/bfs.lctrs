#include ../mem_ds/array.lctrs
#include ../mem_ds/queue.lctrs
#include ../term_ds/graph.lctrs

/* bfs */
/* graph, currentNode */
bfs :: graph -> Int -> Int
bfs1 :: graph -> Int -> Int -> Int
bfs2 :: graph -> list -> Int -> Int
bfs3 :: graph -> Int -> Int -> list -> Int
bfs4 :: graph -> Int -> Int -> list -> list -> Bool -> Int
bfs5 :: graph -> Int -> Int -> list -> list -> Int -> Int

bfs(graph, start) -> bfs1(graph, start, createArray(numNodes(graph)))
bfs1(graph, start, addr) -> bfs2(graph, cons(start, nil), addr)
bfs2(graph, nil, addr) -> addr
bfs2(graph, cons(x, stk), addr) -> bfs3(graph, addr, x, stk)
bfs3(graph, addr, x, stk) -> bfs4(graph, addr, x, stk, getAdj(x, graph), setArr(addr, x, 1))
bfs4(graph, addr, x, stk, nil, true) -> bfs2(graph, stk, addr)
bfs4(graph, addr, x, stk, cons(u, l), true) ->
    bfs5(graph, addr, x, stk, cons(u, l), getArr(addr, u))
bfs5(graph, addr, x, stk, cons(u, l), 0) -> bfs4(graph, addr, x, cons(u, stk), l, true)
bfs5(graph, addr, x, stk, cons(u, l), 1) -> bfs4(graph, addr, x, stk, l, true)

/* bfs: multi-core */
parBFS :: graph -> Int -> Int
parBFSAlloc :: graph -> Int -> Int -> Int
parBFSSeed :: graph -> Int -> Int -> Int -> Int -> Int
parBFSLayer :: graph -> Int -> Int -> Int -> Bool -> Bool -> Int
parBFSSync :: graph -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int
bfsWorker :: graph -> Int -> Int -> Int -> Int
bfsWorkerLoadAdj :: graph -> Int -> Int -> Int -> Int
bfsWorkerScanAdj :: graph -> Int -> Int -> Int -> list -> Int
bfsWorkerClaim :: graph -> Int -> Int -> Int -> list -> Bool -> Int
bfsWorkerEnqueue :: graph -> Int -> Int -> Int -> list -> Bool -> Int

/* 1) create array, create queue for the current layer, create queue for the next layer */
parBFS(graph, start) -> parBFSAlloc(graph, start, numNodes(graph))
parBFSAlloc(graph, start, size) ->
    parBFSSeed(graph, start, createArray(size),
        createQueue(size * size + 1), createQueue(size * size + 1)) | size >= 0
parBFSAlloc(graph, start, size) -> -1 | size < 0
/* 2) insert start node to the current queue */
parBFSSeed(graph, start, array, queue1, queue2) ->
    parBFSLayer(graph, array, queue1, queue2,
        push(queue1, start), SET(array + 1 + start, 1))
/* 3) pop nodes from the current queue in parallel */
parBFSLayer(graph, array, queue1, queue2, true, true) ->
    parBFSSync(graph, array, queue1, queue2,
        bfsWorker(graph, array, queue2, pop(queue1)),
        bfsWorker(graph, array, queue2, pop(queue1)),
        bfsWorker(graph, array, queue2, pop(queue1)),
        bfsWorker(graph, array, queue2, pop(queue1)),
        bfsWorker(graph, array, queue2, pop(queue1)),
        bfsWorker(graph, array, queue2, pop(queue1)),
        bfsWorker(graph, array, queue2, pop(queue1)),
        bfsWorker(graph, array, queue2, pop(queue1)),
        bfsWorker(graph, array, queue2, pop(queue1)),
        bfsWorker(graph, array, queue2, pop(queue1)))
/* 4) explore child nodes in parallel, add to the next layer queue */
bfsWorker(graph, array, queue, x) -> 0 | x < 0
bfsWorker(graph, array, queue, x) -> bfsWorkerLoadAdj(graph, array, queue, x) | x >= 0
/* 4.1) for current node: fetch the graph row, set current node as visited */
bfsWorkerLoadAdj(graph, array, queue, x) ->
    bfsWorkerScanAdj(graph, array, queue, x, getAdj(x, graph))
/* 4.2) push all non-visited nodes in the new layer */
bfsWorkerScanAdj(graph, array, queue, x, cons(u, newNodes)) ->
    bfsWorkerClaim(graph, array, queue, x, cons(u, newNodes), CAS(array + 1 + u, 0, 1))
bfsWorkerClaim(graph, array, queue, x, cons(u, newNodes), true) ->
    bfsWorkerEnqueue(graph, array, queue, x, newNodes, push(queue, u))
bfsWorkerClaim(graph, array, queue, x , cons(u, newNodes), false) ->
    bfsWorkerScanAdj(graph, array, queue, x , newNodes)
bfsWorkerEnqueue(graph, array, queue, x , newNodes, true) ->
    bfsWorkerScanAdj(graph, array, queue, x , newNodes)
/* 4.3) return 1 */
bfsWorkerScanAdj(graph, array, queue, x , nil) -> 1
/* 5) If all workers were scheduled => try fetching nodes from the current layer */
parBFSSync(graph, array, queue1 , queue2, c1 , c2, c3, c4, c5, c6, c7, c8, c9, c10) ->
    parBFSLayer(graph, array, queue1 , queue2 , true, true)
        | c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 = 10
/* 6) If some workers were not scheduled => swap queues and launch parallel step for new layer */
parBFSSync(graph, array, queue1, queue2, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10) ->
    parBFSLayer(graph, array, queue2, queue1, true, true)
        | (c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 < 10) /\
          (c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 > 0)
/* 7) If none of the workers were scheduled => finish the algorithm, return the array address */
parBFSSync(graph, array, queue1, queue2, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10) -> array
    | c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 = 0