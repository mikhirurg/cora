#include ../mem_ds/array.lctrs

/* Quick Sort */
partitionArray :: Int -> Int -> Int -> Int
partitionLoop :: Int -> Int -> Int -> Int -> Int -> Int -> Int
partitionCheck :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int
partitionSwapStep :: Int -> Int -> Int -> Int -> Int -> Int -> Bool -> Int
partitionReturn :: Int -> Bool -> Int

partitionArray(addr, l, r) -> partitionLoop(addr, l, r, getArr(addr, r), l, l)
partitionLoop(addr, l, r, pivot, i, j) ->
    partitionCheck(addr, l, r, pivot, i, j, getArr(addr, j)) | j < r
partitionCheck(addr, l, r, pivot, i, j, jVal) ->
    partitionSwapStep(addr, l, r, pivot, i, j, swapArr(addr, i, j)) | jVal <= pivot
partitionCheck(addr, l, r, pivot, i, j, jVal) ->
    partitionLoop(addr, l, r, pivot, i, j + 1) | jVal > pivot
partitionSwapStep(addr, l, r, pivot, i, j, true) ->
    partitionLoop(addr, l, r, pivot, i + 1, j + 1)
partitionLoop(addr, l, r, pivot, i, j) -> partitionReturn(i, swapArr(addr, i, r)) | j >= r
partitionReturn(i, true) -> i

qsortArray :: Int -> Int -> Int -> Bool
qsortSplit :: Int -> Int -> Int -> Int -> Bool
qsortMerge :: Bool -> Bool -> Bool

qsortArray(addr, l, r) -> true | r - l <= 0
qsortArray(addr, l, r) -> qsortSplit(addr, l, r, partitionArray(addr, l, r)) | r - l > 0
qsortSplit(addr, l, r, q) ->
    qsortMerge(qsortArray(addr, l, q - 1), qsortArray(addr, q + 1, r))
qsortMerge(left, right) -> left /\ right