#include ../kernel.lctrs

/* ===================== IN-MEM DS: QUEUE (Thread-Safe) ====================== */

/* Create Queue */
/* Arguments: Capacity */
/* MEM LAYOUT: |<capacity>|<monitor>|<currSize>|<front>|...data...| */
createQueue :: Int -> Int
createQueueStoreCap :: Int -> Int -> Int
createQueueInitRest :: Int -> Int -> Bool -> Int
createQueueInitLoop :: Int -> Int -> Int -> Int
createQueueInitStep :: Int -> Int -> Int -> Bool -> Int
createQueue(cap) -> createQueueStoreCap(alloc(cap + 4), cap) | cap > 0
createQueue(cap) -> -1 | cap <= 0
createQueueStoreCap(addr, cap) -> createQueueInitRest(addr, cap, SET(addr, cap)) | addr >= 0
createQueueStoreCap(addr, cap) -> -1 | addr < 0
createQueueInitRest(addr, cap, true) -> createQueueInitLoop(addr, addr + 1, cap + 3)
createQueueInitLoop(queueAddr, addr, remaining) ->
    createQueueInitStep(queueAddr, addr + 1, remaining - 1, SET(addr , 0)) | remaining > 0
createQueueInitLoop(queueAddr, addr, remaining) -> queueAddr | remaining <= 0
createQueueInitStep(queueAddr, addr, remaining, true) ->
    createQueueInitLoop(queueAddr, addr, remaining)

/* Push element to the queue */
push :: Int -> Int -> Bool
pushTryLock :: Int -> Int -> Bool -> Bool
pushCheckSpace :: Int -> Int -> Int -> Bool -> Bool
pushCommit :: Int -> Bool -> Bool -> Bool
pushUnlockFail :: Int -> Bool
pushUnlockSuccess :: Int -> Bool
push(addr, element) -> pushTryLock(addr, element, CAS(addr + 1, 0, 1))
/* spin lock */
pushTryLock(addr, element, false) -> push(addr, element)
/* we insert a new element if there is free space in the queue */
/* first, we compute the location of the rear */
pushTryLock(addr, element, true) ->
    pushCheckSpace(addr, element,
        (GET(addr + 3) + GET(addr + 2)) % GET(addr), GET(addr + 2) < GET(addr))
/* then if there is space in the queue we insert the element at the rear position
and increment the size */
pushCheckSpace(addr, element, rear, true) ->
    pushCommit(addr, SET(addr + 4 + rear, element), SET(addr + 2, GET(addr + 2) + 1))
        | rear = rear
/* we can't insert the elem, so return null and unlock the queue */
pushCheckSpace(addr, element, rear, false) -> pushUnlockFail(addr)
pushUnlockFail(addr) -> SET(addr + 1, 0) /\ false
/* release the lock */
pushCommit(addr, true, true) -> pushUnlockSuccess(addr)
pushUnlockSuccess(addr) -> SET(addr + 1, 0)

/* Pop element from the queue */
pop :: Int -> Int
popTryLock :: Int -> Bool -> Int
popCheckNonEmpty :: Int -> Bool -> Int
popReadFront :: Int -> Int -> Int
popCommit :: Int -> Int -> Bool -> Bool -> Int
popUnlock :: Int -> Int -> Bool -> Int
pop(addr) -> popTryLock(addr, CAS(addr + 1, 0, 1))
/* spin lock */
popTryLock(addr, false) -> pop(addr)
/* we pop the element if there is at least one element in the queue: res = arr[front] */
popTryLock(addr, true) -> popCheckNonEmpty(addr, GET(addr + 2) > 0)
/* we can't pop the element, so we return -1 */
popCheckNonEmpty(addr, false) -> popCommit(addr, -1, true, true)
/* decrease the size of the queue and move the front of the queue */
popCheckNonEmpty(addr, true) ->
    popReadFront(addr, GET(addr + 4 + GET(addr + 3)))
popReadFront(addr, element) ->
    popCommit(addr, element, SET(addr + 2, GET(addr + 2) - 1),
           SET(addr + 3, (GET(addr + 3) + 1) % GET(addr)))
/* release the lock */
popCommit(addr, element, true, true) -> popUnlock(addr, element, SET(addr + 1, 0))
popUnlock(addr, element, true) -> element