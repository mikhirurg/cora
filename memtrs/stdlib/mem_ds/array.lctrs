#include ../kernel.lctrs
#include ../term_ds/list.lctrs

/* ================================== IN-MEM DS: ARRAY ========================================== */

/* Create Array */

/* signature: size -> Bool */
createArray :: Int -> Int
createArraySetSize :: Int -> Int -> Int
createArraySetSizeDone :: Int -> Int -> Bool -> Int
createArrayFillZeros :: Int -> Int -> Int -> Int
createArrayFillZerosDone :: Int -> Int -> Int -> Bool -> Int
createArray(size) -> createArraySetSize(alloc(size + 1), size) | size > 0
createArray(size) -> -1 | size <= 0
createArraySetSize(addr, size) ->
    createArraySetSizeDone(addr, size, SET(addr, size)) | addr >= 0
createArraySetSize(addr, size) -> -1 | addr < 0
createArraySetSizeDone(addr, size, true) -> createArrayFillZeros(addr, addr + 1, size)
createArrayFillZeros(aAddr, addr, rem) ->
    createArrayFillZerosDone(aAddr, addr + 1, rem - 1, SET(addr, 0)) | rem > 0
createArrayFillZeros(aAddr, addr, rem) -> aAddr | rem <= 0
createArrayFillZerosDone(aAddr, addr, rem, true) ->
    createArrayFillZeros(aAddr, addr, rem)

/* ACCESS Array element */
/* addr -> index -> value */
getArr :: Int -> Int -> Int
getArrBounds :: Int -> Int -> Int -> Int
getArr(addr, i) -> getArrBounds(addr, i, GET(addr))
getArrBounds(addr, i, size) -> GET(addr + i + 1) | 0 <= i /\ i < size
getArrBounds(addr, i, size) -> -1 | i < 0 \/ i >= size

/* SET Array element */
/* addr -> index -> value -> is successful? */
setArr :: Int -> Int -> Int -> Bool
setArrBounds :: Int -> Int -> Int -> Int -> Bool
setArr(addr, i, value) -> setArrBounds(addr, i, value, GET(addr))
setArrBounds(addr, i, value, size) -> SET(addr + i + 1, value) | 0 <= i /\ i < size
setArrBounds(addr, i, value, size) -> false | i < 0 \/ i >= size

/* Get Array size */
getArrSize :: Int -> Int
getArrSize(addr) -> GET(addr)

/* Fill Array */
fillArray :: Int -> Int -> Bool
fillArrayLoop :: Int -> Int -> Int -> Int -> Bool
fillArrayStep :: Int -> Int -> Int -> Int -> Bool -> Bool

fillArray(addr, val) -> fillArrayLoop(addr, val, 0, getArrSize(addr))
fillArrayLoop(addr, val, i, size) ->
    fillArrayStep(addr, val, i, size, setArr(addr, i, val)) | i < size
fillArrayLoop(addr, val, i, size) -> true | i >= size
fillArrayStep(addr, val, i, size, true) -> fillArrayLoop(addr, val, i + 1, size)
fillArrayStep(addr, val, i, size, false) -> false

/* Swap Array elements */
/* addr -> i1 -> i2 -> Bool */
swapArr :: Int -> Int -> Int -> Bool
swapArrBounds :: Int -> Int -> Int -> Int -> Bool
swapArrLoad :: Int -> Int -> Int -> Int -> Int -> Bool
swapArrWrite :: Bool -> Bool -> Bool

swapArr(addr, i1, i2) -> swapArrBounds(addr, i1, i2, GET(addr))
swapArrBounds(addr, i1, i2, size) -> false | (i1 >= size) \/ (i2 >= size) \/ (i1 < 0) \/ (i2 < 0)
swapArrBounds(addr, i1, i2, size) ->
    swapArrLoad(addr, i1, i2, GET(addr + i1 + 1), GET(addr + i2 + 1))
    | (0 <= i1 ) /\ (i1 < size) /\ (0 <= i2 ) /\ (i2 < size)
swapArrLoad(addr, i1, i2, val1, val2) ->
    swapArrWrite(SET(addr + i2 + 1, val1), SET(addr + i1 + 1, val2))
swapArrWrite(status1, status2) -> true | status1 /\ status2
swapArrWrite(status1, status2) -> false | not(status1 /\ status2)

/* Array to List */
arrayToList :: Int -> list
arrayToList1 :: Int -> Int -> list
arrayToList(addr) -> arrayToList1(addr, GET(addr))
arrayToList1(addr, size) -> readRange(addr + 1, addr + size)

/* List to Array */
listToArray :: list -> Int
listToArray1 :: list -> Int -> Int -> Int
listToArray2 :: list -> Int -> Int -> Int -> Int
listToArray3 :: list -> Int -> Int -> Int -> Bool -> Int
listToArray(l) -> listToArray1(l, createArray(listLen(l)), listLen(l))
listToArray1(l, addr, size) -> listToArray2(l, addr, size, 0)
listToArray2(cons(el, l), addr, size, i) ->
    listToArray3(l, addr, size, i, setArr(addr, i, el)) | i < size
listToArray3(l, addr, size, i, true) -> listToArray2(l, addr, size, i + 1)
listToArray2(nil, addr, size, i) -> addr

/* ============================================================================================== */