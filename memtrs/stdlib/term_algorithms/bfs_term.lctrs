#include ../term_ds/graph.lctrs
#include ../term_ds/list.lctrs

/* bfs */
/* graph, currentNode, queue, visitedNodes */
seqBFS :: graph -> Int -> list
seqBFSQueue :: graph -> list -> list -> list
seqBFSVisit :: graph -> Int -> list -> list -> list
seqBFSScanAdj :: graph -> Int -> list -> list -> list -> list
seqBFSCheckNeighbor :: graph -> Int -> list -> list -> list -> Int -> list

seqBFS(graph, v) -> seqBFSQueue(graph, cons(v , nil), genList(numNodes(graph)))
seqBFSQueue(graph, nil, visited ) -> visited
seqBFSQueue(graph, cons(x, q), visited) -> seqBFSVisit(graph, x, q, visited)
seqBFSVisit(graph, x, q, visited) ->
    seqBFSScanAdj(graph, x, q, setl(x, 1, visited), getAdj(x, graph))
seqBFSScanAdj(graph, x, q, visited, nil) -> seqBFSQueue(graph, q, visited)
seqBFSScanAdj(graph, x, q, visited, cons(u, l)) ->
    seqBFSCheckNeighbor(graph, x, q, visited, cons(u, l), getl(u, visited))
seqBFSCheckNeighbor(graph, x, q, visited, cons(u, l), isVisited) ->
    seqBFSScanAdj(graph, x, pushBack(u, q), visited, l) | isVisited = 0
seqBFSCheckNeighbor(graph, x, q, visited, cons(u, l), isVisited) ->
    seqBFSScanAdj(graph, x, q, visited, l) | isVisited = 1