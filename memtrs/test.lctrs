/* #include preproc/stdlib/term_algorithms/quicksort_term.lctrs */
#include preproc/stdlib/kernel.lctrs

start :: Int -> Int -> Int
s :: Bool -> Bool -> Int
t :: Bool -> Bool -> Int
start(x, y) -> s(SET(0, x), SET(1, y))
s(true, true) -> t(pow(0, 2), pow(1, 2))
t(true, true) -> GET(0) + GET(1)

pow :: Int -> Int -> Bool
pow1 :: Int -> Int -> Int -> Bool
pow2 :: Int -> Int -> Bool -> Int -> Bool
pow3 :: Int -> Int -> Bool -> Int -> Bool
pow(a, x) -> pow1(a, GET(a), x)
pow1(a, v, x) -> pow2(a, v, SET(a, 1), x)
pow2(a, v, true, x) -> pow3(a, v, SET(a, v * GET(a)), x - 1) | x > 0
pow2(a, v, true, x) -> true | x <= 0
pow3(a, v, true, x) -> pow2(a, v, true, x)

