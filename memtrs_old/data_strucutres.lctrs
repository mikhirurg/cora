e1 :: list -> list
e2 :: Int -> Bool -> list
e3 :: Int -> Bool -> list
e1(l) -> e2(listLen(l), listToArray(l, 0))
e2(size, true) -> e3(2 * size + 2, heapSort(0, size + 1, 2 * size + 2))
e3(addr, true) -> arrayToList(addr)

ex1 :: list -> list
ex2 :: Int -> Bool -> list
ex3 :: Int -> Bool -> list
ex1(l) -> ex2(listLen(l), listToArray(l, 0))
ex2(size, true) -> ex3(0, qSort(0, 0, size))
ex3(addr, true) -> arrayToList(addr)